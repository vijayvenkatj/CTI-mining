{
  "kafka": {
    "brokers": ["localhost:9092"],
    "edge_generator": {
      "reader": {
        "topic": "cti-pulses",
        "group_id": "cti-miner"
      },
      "writer": {
        "topic": "cti-edges"
      }
    },
    "estimator": {
      "reader": {
        "topic": "cti-edges",
        "group_id": "cti-miner-estimator"
      }
    }
  },
  "otx": {
    "api_key": "your-otx-api-key"
  }
}
